# 1Password reference file for Foreman.
# Safe to commit — contains references, not secret values.
# Resolved at runtime via: op run --env-file=.env.op -- <command>
# Requires: 1Password CLI signed in (op signin)
#
# Source item: op item get Roboflow --vault=Private

ROBOFLOW_API_KEY=op://Private/Roboflow/password
ROBOFLOW_WORKSPACE=op://Private/Roboflow/workspace-id
ROBOFLOW_PROJECT=op://Private/Roboflow/project-slug
ROBOFLOW_PUBLISHABLE_KEY=op://Private/Roboflow/publishable-key

# Linear API — used by archon-foreman-preflight (fetch issue) and
# archon-foreman-ship (post comment, resolve issue UUID). Workflows
# treat LINEAR_API_KEY as optional with graceful skip if unset.
LINEAR_API_KEY=op://Private/Linear/credential
LINEAR_WORKSPACE=op://Private/Linear/workspace
LINEAR_DEFAULT_TEAM=op://Private/Linear/default-team-key
