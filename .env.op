# 1Password reference file for Foreman.
# Safe to commit — contains references, not secret values.
# Resolved at runtime via: op run --env-file=.env.op -- <command>
# Requires: 1Password CLI signed in (op signin)
#
# Source items: op item get Roboflow / Linear --vault=Private
#
# Non-secret config (workspace slugs, team keys, project IDs) is intentionally
# NOT here — those live in workflow YAML, CLAUDE.md, or .archon/config.yaml.
# This file is for credentials only.

ROBOFLOW_API_KEY=op://Private/Roboflow/password
LINEAR_API_KEY=op://Private/Linear/credential
