  },
  "stable_contract_names": {
    "detection_block": "p1_object_detection",
    "all_detections": "all_detections",
    "violation_filter": "ppe_violation_filter",
    "violation_output": "ppe_violations",
    "violation_count": "ppe_violation_count",
    "violation_expression": "ppe_violation_expression",
    "post_expression_positive_branch": "post_expression_violation_positive",
    "active_learning_dedupe_key": "dedupe_key",
    "violations": "violations",
    "has_violations": "has_violations"
  },
  "model": {
    "project_id": "mikes-workspace-3onpi/construction-site-safety-djmru",
    "model_id": "construction-site-safety-djmru/1",
    "source": "P1 Roboflow RF-DETR Small baseline"
  },
  "active_learning_sinks": [
    {
      "name": "shared_violation_positive_examples",
      "workspace_slug": "mikes-workspace-3onpi",
      "project_slug": "foreman-violation-active-learning",
      "target": "mikes-workspace-3onpi/foreman-violation-active-learning",
      "provisioning": "pre_provisioned",
      "source_output": "post_expression_violation_positive",
      "positive_gate_output": "has_violations",
      "scope": "violation-positive examples only",
      "record_contract": {
        "dedupe_key": {
          "name": "dedupe_key",
          "required": true,
          "derivation_stage": "before_class_expansion",
          "primary_identity": "upstream positive frame/source event identity",
          "preferred_source": "persisted event_id or frame_id when present",
          "fallback_source": "stable composite of normalized source identity plus frame index, event timestamp or offset, and capture-window identity",
          "empty_value_allowed": false
        },
        "collapse_strategy": {
          "key": "dedupe_key",
          "one_sink_example_per": "positive frame/source event",
          "duplicate_class_expanded_records": "collapse_to_one_visual_example",
          "preserve_metadata": [
            "noncompliance_classes",
            "noncompliance_reasons",
            "source_detections"
          ]
        },
        "record_scope": "one positive frame/source event maps to one active-learning sink example, not one noncompliance class"
      }
    }
  ],
  "alert_sink_stubs": [
    {
      "name": "email_violation_alert_stub",
      "type": "email",
      "enabled": false,
      "environment": "test_only",
      "delivery_mode": "disabled",
      "sends_live_notifications": false,
      "gate_output": "has_violations",
      "source_output": "ppe_violations",
      "placeholder_recipient": "foreman-alerts@example.invalid",
      "placeholder_subject": "[TEST ONLY] Foreman PPE violation alert",
      "notes": "Disabled non-production placeholder; replace before production handoff."
    },
    {
      "name": "slack_violation_alert_stub",
      "type": "slack",
      "enabled": false,
      "environment": "test_only",
      "delivery_mode": "disabled",
      "sends_live_notifications": false,
      "gate_output": "has_violations",
      "source_output": "ppe_violations",
      "placeholder_webhook_url": "https://example.invalid/slack/foreman-alerts-placeholder",
      "placeholder_channel": "#foreman-alerts-placeholder",
      "notes": "Disabled non-production placeholder; replace before production handoff."
    }
  ],
  "specification": {
    "version": "1.0",
    "inputs": [
      {
        "type": "WorkflowImage",
        "name": "image"
      }
    ],
    "steps": [
      {
        "type": "roboflow_core/roboflow_object_detection_model@v3",
        "name": "p1_object_detection",
        "images": "$inputs.image",
        "model_id": "construction-site-safety-djmru/1",
        "confidence_mode": "default",
        "class_filter": null
      },
      {
        "type": "roboflow_core/detections_filter@v1",
        "name": "ppe_violation_filter",
        "predictions": "$steps.p1_object_detection.predictions",
        "operations": [
          {
            "type": "DetectionsFilter",
            "filter_operation": {
              "type": "StatementGroup",
              "statements": [
                {
                  "type": "BinaryStatement",
                  "left_operand": {
                    "type": "DynamicOperand",
                    "operations": [
                      {
                        "type": "ExtractDetectionProperty",
                        "property_name": "class_name"
                      }
                    ]
                  },
                  "comparator": {
                    "type": "in (Sequence)"
                  },
                  "right_operand": {
                    "type": "DynamicOperand",
                    "operand_name": "classes"
                  }
                }
              ]
            }
          }
        ],
        "operations_parameters": {
          "classes": [
            "NO-Hardhat",
            "NO-Safety Vest",
            "NO-Mask"
          ]
        }
      },
      {
        "type": "roboflow_core/property_definition@v1",
        "name": "ppe_violation_count",
        "data": "$steps.ppe_violation_filter.predictions",
        "operations": [
          {
            "type": "DetectionsPropertyExtract",
            "property_name": "count"
          }
        ]
      },
      {
        "type": "roboflow_core/expression@v1",
        "name": "ppe_violation_expression",
        "data": {
          "violations": "$steps.ppe_violation_count.output"
        },
        "switch": {
          "type": "CasesDefinition",
          "cases": [
            {
              "type": "CaseDefinition",
              "condition": {
                "type": "StatementGroup",
                "statements": [
                  {
                    "type": "BinaryStatement",
                    "left_operand": {
                      "type": "DynamicOperand",
                      "operand_name": "violations"
                    },
                    "comparator": {
                      "type": ">"
                    },
                    "right_operand": {
                      "type": "StaticOperand",
                      "value": 0
                    }
                  }
                ]
              },
              "result": {
                "type": "StaticCaseResult",
                "value": true
              }
            }
          ],
          "default": {
            "type": "StaticCaseResult",
            "value": false
          }
        }
      },
      {
        "type": "roboflow_core/expression@v1",
        "name": "post_expression_violation_positive",
        "data": {
          "has_violations": "$steps.ppe_violation_expression.output",
          "ppe_violations": "$steps.ppe_violation_filter.predictions"
        },
        "switch": {
          "type": "CasesDefinition",
          "cases": [
            {
              "type": "CaseDefinition",
              "condition": {
                "type": "StatementGroup",
                "statements": [
                  {
                    "type": "BinaryStatement",
                    "left_operand": {
                      "type": "DynamicOperand",
                      "operand_name": "has_violations"
                    },
                    "comparator": {
                      "type": "=="
                    },
                    "right_operand": {
                      "type": "StaticOperand",
                      "value": true
                    }
                  }
                ]
              },
              "result": {
                "type": "DynamicCaseResult",
                "operand_name": "ppe_violations"
              }
            }
          ],
          "default": {
            "type": "StaticCaseResult",
            "value": []
          }
        }
      }
    ],
    "outputs": [
      {
        "type": "JsonField",
        "name": "p1_object_detection_predictions",
        "selector": "$steps.p1_object_detection.predictions"
      },
      {
        "type": "JsonField",
        "name": "all_detections",
        "selector": "$steps.p1_object_detection.predictions"
      },
      {
        "type": "JsonField",
        "name": "ppe_violations",
        "selector": "$steps.ppe_violation_filter.predictions"
      },
      {
        "type": "JsonField",
        "name": "violations",
        "selector": "$steps.ppe_violation_count.output"
      },
      {
        "type": "JsonField",
        "name": "has_violations",
        "selector": "$steps.ppe_violation_expression.output"
      },
      {
        "type": "JsonField",
        "name": "post_expression_violation_positive",
        "selector": "$steps.post_expression_violation_positive.output"
      }
    ]
  },
  "validation": {
    "workflow_specs_validate": "ok",
    "smoke_sample": {
      "source_id": "sQjCnvmNIDSIzCdo18Tj",
      "source_url": "https://source.roboflow.com/eAJgsCvc6xSScw2L9EtTS3lPH4o2/sQjCnvmNIDSIzCdo18Tj/original.jpg",
      "prediction_count": 4,
      "classes": [
        "Person",
        "Safety Vest",
        "Hardhat",
        "Mask"
      ]
    }
  },
  "scope_notes": [
    "MIS-1173 adds ppe_violation_count and ppe_violation_expression on top of the existing ppe_violations branch.",
    "ppe_violation_count derives violations from $steps.ppe_violation_filter.predictions only; ppe_violation_expression evaluates only violations > 0.",
    "ppe_violation_filter keeps only exact class_name matches for NO-Hardhat, NO-Safety Vest, and NO-Mask, preserving original prediction object shape and order.",
    "ppe_violations maps directly to $steps.ppe_violation_filter.predictions; raw/all detections remain debug outputs only.",
    "violations is the numeric count from $steps.ppe_violation_filter.predictions only, and has_violations is the expression result for violations > 0.",
    "post_expression_violation_positive is the named positive branch immediately downstream of has_violations; it returns ppe_violations only when has_violations is true and returns an empty list otherwise.",
    "active_learning_sinks declares one pre-provisioned shared Roboflow project target for violation-positive examples: mikes-workspace-3onpi/foreman-violation-active-learning, sourced from post_expression_violation_positive.",
    "active_learning_sinks requires a non-empty dedupe_key computed before class expansion from the upstream positive frame/source event identity, preferring persisted event/frame IDs and falling back to a stable source/frame/timestamp/window composite.",
    "The active-learning sink collapses duplicate class-expanded records with the same dedupe_key into one visual example while preserving merged noncompliance classes, reasons, and source detections as metadata.",
    "Validator samples reject missing or empty active-learning dedupe_key values and prove same-key class-expanded records collapse while distinct positive frame/source events remain separate.",
    "MIS-1185 evidence alignment confirms this file is the canonical export for the shared_violation_positive_examples sink path without changing active-learning routing semantics.",
    "alert_sink_stubs declares disabled/test-only Email and Slack placeholders gated by has_violations; committed values do not send live notifications.",
    "Production notification delivery, visualization, normalization, enrichment, person-correlation, raw-detection fallback, compliant-detection counting, and person/PPE totals remain deferred."
  ]
}
